# Movewell Family Environment Configuration Template
# Copy this file to .env and set your local credentials.

# Server settings
MOVEWELL_ENV=development
MOVEWELL_PORT=8000
MOVEWELL_HOST=0.0.0.0

# Security & Secret Keys (Use random secret keys in production)
MOVEWELL_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# AI & LLM Services (Optional / Model Context Protocol Integration)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# External Integrations (Optional)
HEVY_API_KEY=your_hevy_api_key_here
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_long_lived_access_token_here

# Vision Service Configuration
VISION_PORT=2091
VISION_ENABLED=true
